# 复制为 .env 并填入真实值（.env 已被 gitignore）。deploy/start-all.sh 自动加载。
NACOS_PASSWORD=

# 真实 LLM（OpenAI 兼容接口）。不填 LLM_API_KEY 则 ai-engine 走确定性 stub，仍可端到端通关。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=

# 嵌入向量（OpenAI 兼容）。不填则 memory 走确定性伪向量兜底（弱依赖，不影响主流程）。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
