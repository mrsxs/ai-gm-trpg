# 复制为 .env 并填入真实值（.env 已被 gitignore）。deploy/start-all.sh 自动加载。

# ===== 中间件连接（默认指向本地 localhost；连远端时在此覆盖）=====
# Nacos 注册/配置中心
NACOS_ADDR=localhost:8848
NACOS_PASSWORD=nacos
# MySQL（aigm_user / aigm_scenario / aigm_game 分库）
MYSQL_HOST=localhost
MYSQL_PASSWORD=root
# PostgreSQL（aigm_memory）
PG_HOST=localhost
PG_PASSWORD=postgres
# Redis（sa-token 会话）
REDIS_HOST=localhost
REDIS_PASSWORD=

# ===== 真实 LLM（OpenAI 兼容接口）=====
# 不填 LLM_API_KEY 则 ai-engine 走确定性 stub，仍可端到端通关。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=

# ===== 嵌入向量（OpenAI 兼容）=====
# 不填则 memory 走确定性伪向量兜底（弱依赖，不影响主流程）。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
